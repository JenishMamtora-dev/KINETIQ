# AI & Core App Config
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://kinetiq.design"
NODE_ENV="production" # development | staging | production

# Database & Search (PostgreSQL + pg_trgm + tsvector)
DATABASE_URL="postgresql://kinetiq_admin:vault_password@localhost:5432/kinetiq_marketplace?sslmode=require"

# Transactional Email Provider (Resend or Postmark)
# Leave blank to operate in setup-required mode in admin dashboard
EMAIL_PROVIDER="resend" # resend | postmark
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM_ADDRESS="concierge@kinetiq.design"

# Bot Protection & Abuse Controls
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Error Monitoring (Sentry, optional)
SENTRY_DSN=""

# Storage & Deliverables Private Buckets
AWS_S3_DELIVERABLES_BUCKET="kinetiq-private-deliverables"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

